POSTGRES_DB=smart_campus
POSTGRES_USER=smart_campus
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+asyncpg://smart_campus:change_me@postgres:5432/smart_campus
QDRANT_URL=http://qdrant:6333
REDIS_URL=redis://redis:6379/0
BACKEND_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# LLM
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=

# Embedding
EMBEDDING_PROVIDER=qwen
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# For a future OpenAI-compatible local/private deployment, set the relevant
# PROVIDER to local or private and point BASE_URL at the private endpoint.

# Qdrant
QDRANT_COLLECTION=smart_campus_knowledge

# RAG
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=5
RAG_MAX_UPLOAD_BYTES=10485760
